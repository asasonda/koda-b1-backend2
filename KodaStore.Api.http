@baseUrl = http://localhost:5079

GET {{baseUrl}}/api/v1/products
Accept: application/json

### post
POST {{baseUrl}}/api/v1/products
Accept: application/json
Content-Type: application/json

{
    "productCode" : "P0001",
    "name" : "Keyboard",
    "price": 50000,
    "stock": 10,
    "category": "elektronik"
}

### Put
PUT {{baseUrl}}/api/v1/products/P0001
Accept: application/json
Content-Type: application/json

{
    "productCode" : "P0001",
    "name" : "Keyboard",
    "price": 40000,
    "stock": 5,
    "category": "elektronik"
}

## delete
DELETE {{baseUrl}}/api/v1/products/P0001
Accept: application/json
Content-Type: application/json
